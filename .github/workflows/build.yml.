name: Build PSP EBOOT
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    container: pspdev/pspdev:latest
    steps:
      - uses: actions/checkout@v4
      - name: Build
        run: make
      - name: Package
        run: |
          mkdir -p out/CarDriving
          cp EBOOT.PBP out/CarDriving/
      - uses: actions/upload-artifact@v4
        with:
          name: CarDriving-PSP
          path: out
